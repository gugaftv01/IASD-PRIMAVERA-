rules_version = '2';

// Regras do banco de dados (Firestore) para o formulário "Ouvindo a Voz de Deus".
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador principal (dono), identificado pelo código da conta (UID). Só ele adiciona e remove outros administradores.
    function ehDono() {
      return request.auth != null
        && request.auth.uid == '1Iu6jx216aVasQnBVHov8S6bWay1';
    }

    // Administradores extras: estão na coleção "admins" e precisam ter confirmado o e-mail.
    function ehAdmin() {
      return ehDono() || (request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.get('email', '-'))));
    }

    // Campos que a pessoa pode enviar pelo formulário, conferidos aqui no servidor (OWASP A05/A08).
    // "uid" é o login anônimo (invisível) do aparelho que fez o cadastro.
    function pedidoValido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nome', 'telefone', 'dias', 'horarios', 'horarioLivre', 'criadoEm', 'atualizadoEm', 'contatado', 'uid'])
        && d.tipo in ['dar', 'receber']
        // nome: só letras (com acento), espaço, apóstrofo, ponto e hífen
        && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 100
        && d.nome.matches("^[\\p{L}][\\p{L}' .-]*$")
        // telefone no formato (61) 99999-9999 ou (61) 3333-4444
        && d.telefone is string && d.telefone.matches("^\\([1-9][1-9]\\) 9?[0-9]{4}-[0-9]{4}$")
        && id == d.telefone.replace('[^0-9]', '')
        // dias e horários só da lista do formulário
        && d.dias is list && d.dias.size() >= 1 && d.dias.size() <= 7
        && d.dias.toSet().hasOnly(['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'])
        && d.horarios is list && d.horarios.size() <= 3
        && d.horarios.toSet().hasOnly(['Manhã (8h–12h)', 'Tarde (12h–18h)', 'Noite (18h–22h)'])
        // horário escrito à mão: opcional, curto e sem virar fórmula na planilha
        && (!('horarioLivre' in d) || (d.horarioLivre is string && d.horarioLivre.size() >= 1
              && d.horarioLivre.size() <= 60 && !d.horarioLivre.matches('^[=+@-].*')))
        && (d.horarios.size() >= 1 || 'horarioLivre' in d)
        && d.contatado == false
        && d.uid == request.auth.uid;
    }

    // Pedidos de estudo bíblico: um cadastro por telefone (o nome do documento é o número).
    // - Qualquer pessoa ENVIA um cadastro novo.
    // - Só o mesmo aparelho que criou consegue VER e ALTERAR o próprio cadastro.
    // - Ninguém consegue saber se o telefone de outra pessoa está cadastrado.
    // - Só administradores LISTAM, marcam e apagam.
    match /pedidos/{id} {
      allow create: if request.auth != null
        && pedidoValido(id)
        && request.resource.data.criadoEm == request.time
        && !('atualizadoEm' in request.resource.data);
      allow update: if ehAdmin() || (request.auth != null
        && resource.data.uid == request.auth.uid
        && pedidoValido(id)
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time);
      allow get: if ehAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, delete: if ehAdmin();
    }

    // Histórico de senhas erradas na Área do administrador.
    // O site só consegue ACRESCENTAR um registro (com a hora do servidor); só administradores leem e apagam.
    match /tentativas/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'motivo', 'aparelho', 'quando'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 40
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 200
        && request.resource.data.quando == request.time;
      allow read, delete: if ehAdmin();
    }

    // Registro de cada entrada na Área do administrador (OWASP A09). Só administradores gravam e leem.
    match /acessos/{id} {
      allow create: if ehAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'aparelho', 'quando'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string && request.resource.data.email.size() <= 100
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 200
        && request.resource.data.quando == request.time;
      allow read, delete: if ehAdmin();
    }

    // Lista de administradores extras (o nome do documento é o e-mail).
    match /admins/{email} {
      allow read: if ehAdmin();
      allow create, delete: if ehDono()
        && (request.resource == null || request.resource.data.keys().hasOnly(['adicionadoEm']));
    }
  }
}
